# Database Configuration
DATABASE_URL=postgres://wpplatform_user:wpplatform_pass@localhost:5432/wplatform_db?sslmode=disable
DB_PASSWORD=wpplatform_pass

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=24h

# Server Configuration
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
SERVER_IP=127.0.0.1

# Docker Configuration
DOCKER_HOST=unix:///var/run/docker.sock

# Traefik Configuration
TRAEFIK_EMAIL=your-email@example.com
TRAEFIK_DASHBOARD_URL=http://localhost:8080

# Cloudflare API (Optional - for DNS challenge)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_EMAIL=

# Email Configuration (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@wp-platform.com

# Backup Configuration
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 2 * * *
BACKUP_BASE_PATH=/var/backups/wp

# WordPress Configuration
WORDPRESS_IMAGE=wordpress:6-php8.2-apache

# DNS Configuration
DNS_RESOLVER=8.8.8.8

# Frontend URL
FRONTEND_URL=http://localhost:3000
